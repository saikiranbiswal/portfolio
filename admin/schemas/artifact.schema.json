{
  "$id": "artifact",
  "title": "Artifact (content/artifacts.json → artifacts[])",
  "fields": [
    { "id": "id",    "label": "Slug", "type": "text", "required": true },
    { "id": "title", "label": "Title", "type": "text", "required": true },
    { "id": "kind",  "label": "Kind", "type": "select", "options": ["prd", "journey-map", "metrics", "architecture", "deck", "doc", "other"], "required": true },
    { "id": "body",  "label": "Description", "type": "textarea" },
    { "id": "link",  "label": "Link (file or URL)", "type": "text", "required": true },
    { "id": "image", "label": "Thumbnail", "type": "image" },
    { "id": "visible", "label": "Visible", "type": "bool" }
  ]
}
