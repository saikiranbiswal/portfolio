{
  "$id": "flexible-section",
  "title": "Flexible Section (lane 3)",
  "description": "One-off section configured entirely in admin. Stored in content/pages.json with lane: 3.",
  "fields": [
    { "id": "title",  "label": "Title", "type": "text", "required": true },
    { "id": "body",   "label": "Body", "type": "textarea", "required": true },
    { "id": "layout", "label": "Layout variant", "type": "select", "required": true,
      "options": ["split", "stacked", "metric-led", "card-grid", "full-bleed"] },
    { "id": "preset", "label": "Visual preset", "type": "select", "required": true,
      "options": ["calm-editorial", "case-study", "dark-hero", "minimal-proof", "boardroom"] },
    { "id": "page",   "label": "Page placement", "type": "select", "required": true,
      "options": ["work", "labs", "about", "contact"] }
  ],
  "optionalFields": [
    { "id": "eyebrow",  "label": "Eyebrow", "type": "text" },
    { "id": "image",    "label": "Image", "type": "image" },
    { "id": "metrics",  "label": "Metrics", "type": "metrics" },
    { "id": "quote",    "label": "Quote", "type": "quote" },
    { "id": "cta",      "label": "CTA", "type": "cta" },
    { "id": "evidence", "label": "Evidence", "type": "textarea" },
    { "id": "link",     "label": "Link", "type": "link" },
    { "id": "cards",    "label": "Cards", "type": "cards" }
  ]
}
